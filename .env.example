# Canonical site URL used for metadata, canonical tags, sitemap, robots, and JSON-LD.
# Development: http://localhost:3000
# Preview: https://codeasters.vercel.app
# Production: https://codeasters.com
NEXT_PUBLIC_SITE_URL=https://codeasters.com

# Search engine verification tokens (optional, recommended for production SEO)
# Google Search Console token from HTML tag verification
GOOGLE_SITE_VERIFICATION=DYVP79yt1TN-hxxLWViwA7HuAr-x1kiXQ0ZmZppJiZU
# Bing Webmaster Tools token (msvalidate.01)
BING_SITE_VERIFICATION=26FF4EB008D6A3E351A488B5F7591EDA

# Google Analytics 4 measurement ID (optional)
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1LS5QQMTHD

# EmailJS server-side delivery configuration (required for form submissions)
# Keep these values server-side only. Do not expose in client code.
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_CONTACT=template_xxxxxxx
# Optional: separate templates for other form types.
# If omitted, the contact template is reused.
EMAILJS_TEMPLATE_PROJECT=template_xxxxxxx
EMAILJS_TEMPLATE_AFFILIATE=template_xxxxxxx
# Optional generic fallback template key (used when specific keys are missing)
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxx
# Optional: required only if your EmailJS account enforces private access token checks
EMAILJS_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxx

# MongoDB connection string (required for affiliate system)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret for affiliate authentication (use a strong random string in production)
JWT_SECRET=replace-with-a-random-32-plus-character-secret
