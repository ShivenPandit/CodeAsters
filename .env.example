# Canonical site URL used for metadata, canonical tags, sitemap, robots, and JSON-LD.
# Development: http://localhost:3000
# Preview: https://codeasters.vercel.app
# Production: https://codeasters.com
NEXT_PUBLIC_SITE_URL=https://codeasters.com

# Search engine verification tokens (optional, recommended for production SEO)
# Google Search Console token from HTML tag verification
GOOGLE_SITE_VERIFICATION=DYVP79yt1TN-hxxLWViwA7HuAr-x1kiXQ0ZmZppJiZU
# Bing Webmaster Tools token (msvalidate.01)
BING_SITE_VERIFICATION=26FF4EB008D6A3E351A488B5F7591EDA

# Google Analytics 4 measurement ID (optional)
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1LS5QQMTHD

# MongoDB connection string (required for affiliate system)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret for affiliate authentication (use a strong random string in production)
JWT_SECRET=codeasters-affiliate-secret-change-me
